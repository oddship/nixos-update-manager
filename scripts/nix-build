#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "$0")/build-limits"
# path:. includes untracked, changing target/ files. Explicitly filter build
# artifacts until the repository is committed and normal Git-flake builds work.
attribute="${1:?flake output attribute required}"
shift
case "$attribute" in
  *[!a-zA-Z0-9_.-]*) echo "invalid output attribute" >&2; exit 2 ;;
esac
exec nix build --max-jobs 1 --cores "$CARGO_BUILD_JOBS" --impure --expr "let src = builtins.path {
  path = ./.;
  filter = path: type: !(builtins.elem (baseNameOf path) [ \".aws\" \"__pycache__\" \"target\" \"artifacts\" \".git\" \".direnv\" \".codex\" \".agents\" \"credentials\" \"credentials.toml\" ]) && builtins.substring 0 4 (baseNameOf path) != \".env\";
}; in (builtins.getFlake (builtins.unsafeDiscardStringContext (toString src))).$attribute" "$@"
